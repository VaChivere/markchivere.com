{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "markchivere.com"
        }
      ],
      "destination": "https://www.markchivere.com/$1",
      "permanent": true
    }
  ]
}
